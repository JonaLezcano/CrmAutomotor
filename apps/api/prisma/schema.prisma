// Esquema espejo de arquitectura-crm-concesionarias.md, sección 4.
// Row Level Security (sección 8) se activa vía migración SQL aparte
// (prisma/migrations/.../rls.sql) porque Prisma no genera políticas RLS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  vendedor
  supervisor
  ceo
}

enum EstadoDisponibilidad {
  disponible
  en_salon
  en_llamada
  offline
}

enum TipoCanal {
  instagram
  whatsapp
  web
}

enum Temperatura {
  caliente
  tibio
  frio
}

enum EstadoLead {
  en_bolsa
  asignado
  contactado
  vendido
  perdido
}

model Tenant {
  id        String   @id @default(uuid())
  nombre    String
  marcas    String[]
  plan      String
  fechaAlta DateTime @default(now()) @map("fecha_alta")

  usuarios      Usuario[]
  canales       Canal[]
  leads         Lead[]
  scoringReglas ScoringRegla[]

  @@map("tenants")
}

model Usuario {
  id                   String               @id @default(uuid())
  tenantId             String               @map("tenant_id")
  nombre               String
  dni                  String
  telefono             String
  sector               String
  usuario              String               @unique
  passwordHash         String               @map("password_hash")
  rol                  Rol
  estadoDisponibilidad EstadoDisponibilidad @default(offline) @map("estado_disponibilidad")
  fechaAlta            DateTime             @default(now()) @map("fecha_alta")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  leadsAsignados    Lead[]             @relation("VendedorAsignado")
  leadEventos       LeadEvento[]
  ventas            Venta[]
  notificaciones    Notificacion[]
  pushSuscripciones PushSuscripcion[]

  @@index([tenantId])
  @@map("usuarios")
}

model Canal {
  id       String    @id @default(uuid())
  tenantId String    @map("tenant_id")
  tipo     TipoCanal
  config   Json      @default("{}")
  activo   Boolean   @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@index([tenantId])
  @@map("canales")
}

model Lead {
  id                  String      @id @default(uuid())
  tenantId            String      @map("tenant_id")
  telefono            String
  nombre              String?
  canalOrigenId       String      @map("canal_origen_id")
  fechaPrimerContacto DateTime    @default(now()) @map("fecha_primer_contacto")
  score               Int         @default(0)
  temperatura         Temperatura @default(frio)
  estado              EstadoLead  @default(en_bolsa)
  vendedorAsignadoId  String?     @map("vendedor_asignado_id")
  fechaAsignacion     DateTime?   @map("fecha_asignacion")
  timerVenceEn        DateTime?   @map("timer_vence_en")

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  canalOrigen      Canal        @relation(fields: [canalOrigenId], references: [id])
  vendedorAsignado Usuario?     @relation("VendedorAsignado", fields: [vendedorAsignadoId], references: [id])
  eventos          LeadEvento[]
  ventas           Venta[]

  // Clave de dedup: mismo telefono + tenant = mismo lead (sección 4).
  @@unique([tenantId, telefono])
  @@index([tenantId, estado])
  @@map("leads")
}

model LeadEvento {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  // Nullable: la ingesta de un lead nuevo (sección 5, paso 1) todavía no
  // tiene un vendedor asignado — es un evento generado por el sistema, sin
  // usuario humano detrás. Antes esto se resolvía pasando un id inventado
  // (lead.id) que violaba la FK y abortaba la transacción entera en
  // silencio una vez que RLS pasó a correr todo un request en una sola tx.
  usuarioId String?  @map("usuario_id")
  accion    String
  detalle   String?
  timestamp DateTime @default(now())

  lead    Lead     @relation(fields: [leadId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([leadId])
  @@map("lead_eventos")
}

model ScoringRegla {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  campo     String
  condicion String
  peso      Int

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("scoring_reglas")
}

model Venta {
  id         String   @id @default(uuid())
  leadId     String   @map("lead_id")
  vendedorId String   @map("vendedor_id")
  auto       String
  modelo     String
  plan       String
  cuota      Decimal? @db.Decimal(12, 2)
  monto      Decimal  @db.Decimal(12, 2)
  fecha      DateTime @default(now())

  lead     Lead    @relation(fields: [leadId], references: [id])
  vendedor Usuario @relation(fields: [vendedorId], references: [id])

  @@index([leadId])
  @@map("ventas")
}

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tipo      String
  payload   Json
  leido     Boolean  @default(false)
  timestamp DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, leido])
  @@map("notificaciones")
}

// Suscripción Web Push del navegador (sección 2 y 7): un usuario puede tener
// varias (una por dispositivo/navegador donde aceptó notificaciones).
model PushSuscripcion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  fechaAlta DateTime @default(now()) @map("fecha_alta")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("push_suscripciones")
}
