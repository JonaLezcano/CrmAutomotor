# Superusuario de docker-compose — SOLO para CLI (prisma migrate/db seed/db
# execute). Nunca lo usa la app en runtime: un superusuario/dueño de tabla
# bypassea RLS siempre, sin importar las políticas de rls.sql.
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_automotor?schema=public"

# Rol de runtime para requests HTTP normales, SIN BYPASSRLS — acá sí aplica
# RLS de verdad (ver TenantContextInterceptor + prisma.service.ts). Se crea
# corriendo `prisma/roles.sql` (una vez, como el usuario de DATABASE_URL)
# después de la migración inicial.
DATABASE_URL_APP="postgresql://crm_app:crm_app_dev_password@localhost:5432/crm_automotor?schema=public"

# Rol de runtime para jobs de sistema (bolsa.service.ts → @Cron), CON
# BYPASSRLS a propósito: necesitan ver leads de todos los tenants a la vez.
# Se crea en el mismo prisma/roles.sql.
DATABASE_URL_SYSTEM="postgresql://crm_system:crm_system_dev_password@localhost:5432/crm_automotor?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="cambiar-en-produccion-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambiar-en-produccion-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:5173"
