# Postgres — rol de app normal, sujeto a RLS (ver prisma/rls.sql)
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_automotor?schema=public"

# En dev puede apuntar a lo mismo que DATABASE_URL. Antes de staging, apuntar
# a un rol distinto con BYPASSRLS (ver prisma-system.service.ts).
DATABASE_URL_SYSTEM="postgresql://crm:crm_dev_password@localhost:5432/crm_automotor?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="cambiar-en-produccion-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambiar-en-produccion-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:5173"
